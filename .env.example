POSTGRES_DB=iotdb
POSTGRES_USER=iot
POSTGRES_PASSWORD=change_me
MQTT_ADMIN_PASSWORD=change_me
MQTT_BACKEND_PASSWORD=change_me
JWT_SECRET=change_me_at_least_32_characters_long
APP_ADMIN_PASSWORD=change_me
# Dia chi broker cho ESP32 (IP LAN cua may chay Docker), MQTT qua TLS: vd ssl://192.168.1.10:8883
MQTT_DEVICE_URL=ssl://localhost:8883
# Cong MQTT/TLS mo ra LAN (mac dinh 8883). Doi (vd 8884) neu Windows da giu cong 8883
# (kiem tra: netsh interface ipv4 show excludedportrange protocol=tcp). Nho sua cong trong MQTT_DEVICE_URL theo.
MQTT_TLS_PORT=8883
# Cong web khi chay toan bo he thong bang Docker (docker compose --profile app)
# WEB_PORT: HTTP, chi chuyen huong sang HTTPS; WEB_HTTPS_PORT: giao dien web qua HTTPS
WEB_PORT=8088
WEB_HTTPS_PORT=8443
# ---- Cảnh báo qua email (Gmail). Bỏ trống = tắt. MAIL_PASSWORD là "Mật khẩu ứng dụng" 16 ký tự,
# KHÔNG phải mật khẩu đăng nhập Gmail (Google Account -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=GasGuard
# ---- Cảnh báo Telegram (tùy chọn, bỏ trống = tắt). Token lấy từ @BotFather, KHÔNG commit token thật
TELEGRAM_BOT_TOKEN=
# Địa chỉ web để chèn link "Mở GasGuard" trong email / tin nhắn (bỏ trống nếu chỉ chạy localhost)
APP_PUBLIC_URL=
# Đổi khi nhà mạng chặn api.telegram.org và bạn có relay riêng
# TELEGRAM_API_BASE=https://api.telegram.org
