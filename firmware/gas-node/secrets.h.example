// ============================================================================
// Copy file này thành secrets.h (cùng thư mục) rồi điền giá trị thật.
// secrets.h đã nằm trong .gitignore -> KHÔNG BAO GIỜ commit lên GitHub.
//
// Các dòng MQTT_* và DEVICE_ID: lấy trên web -> Thiết bị -> tab "Xác thực MQTT"
// -> "Cấp thông tin xác thực" -> nút sao chép đoạn secrets.h (mật khẩu chỉ hiện 1 lần).
// MQTT_USE_TLS 1: kết nối mã hóa tới cổng 8883, cần file ca_cert.h cùng thư mục
// (tạo bởi deployment/certs/gen-certs.sh). MQTT_HOST phải là địa chỉ có trong chứng chỉ.
// ============================================================================
#pragma once

#define WIFI_SSID      "Ten-WiFi-2.4GHz"     // ESP32 không bắt được WiFi 5GHz
#define WIFI_PASSWORD  "mat-khau-wifi"

#define MQTT_HOST      "192.168.1.10"        // IP LAN của máy chạy Docker (ipconfig)
#define MQTT_PORT      8883
#define MQTT_USE_TLS   1                     // 1 = MQTT qua TLS (khuyến nghị), 0 = không mã hóa (cổng 1883)
#define DEVICE_ID      "esp32-001"           // = MQTT username = clientId
#define MQTT_PASSWORD  "dan-mat-khau-tu-web"
